From ecffc68b43f2602e38b957a99f06b6098b52bf88 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Tue, 3 Nov 2026 23:29:42 +0200
Subject: [PATCH] WelcomeActivity: no Emergency call button on devices without
 voice

The welcome page always offered "Emergency call", also on Wi-Fi-only
tablets (config_voice_capable=false) where it can only open a dialer that
cannot place the call. Show it only when the device is voice capable.

Change-Id: Idefc99e32046bba31254e960a87e194cc9b1f093
---
 src/org/lineageos/setupwizard/WelcomeActivity.java | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/org/lineageos/setupwizard/WelcomeActivity.java b/src/org/lineageos/setupwizard/WelcomeActivity.java
index 63dcc54..0a6a2b3 100644
--- a/src/org/lineageos/setupwizard/WelcomeActivity.java
+++ b/src/org/lineageos/setupwizard/WelcomeActivity.java
@@ -18,6 +18,7 @@
 package org.lineageos.setupwizard;
 
 import android.os.Bundle;
+import android.telephony.TelephonyManager;
 import android.view.MotionEvent;
 import android.view.View;
 
@@ -35,8 +36,15 @@ public class WelcomeActivity extends BaseSetupWizardActivity {
         super.onCreate(savedInstanceState);
         mRootView = findViewById(R.id.root);
         setNextText(R.string.next);
-        setBackText(R.string.emergency_call);
-        setBackDrawable(null);
+        TelephonyManager tm = getSystemService(TelephonyManager.class);
+        if (tm != null && tm.isVoiceCapable()) {
+            setBackText(R.string.emergency_call);
+            setBackDrawable(null);
+        } else {
+            // No voice calls on this device (config_voice_capable=false, e.g. a Wi-Fi-only
+            // tablet): an "Emergency call" button would lead nowhere.
+            getNavigationBar().getBackButton().setVisibility(View.INVISIBLE);
+        }
         mEnableAccessibilityController =
                 EnableAccessibilityController.getInstance(getApplicationContext());
         mRootView.setOnTouchListener((v, event) ->
