From 31d883bc7cc0d00ea352744278b7ca08ff697741 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Wed, 4 Nov 2026 13:08:04 +0200
Subject: [PATCH] power: 8937: explicit perf locks when perfd does not take the
 boost hints

Touch (interaction) and launch boosts went through perf_hint() only. Some
vendor perfd clients export only perf_lock_* (Huawei's Oreo
libqti-perfd-client on the MediaPad T3 10, msm8917): perf_hint is NULL,
so both boosts were silent no-ops and every drag started at the minimum
CPU clock (960 MHz). When the hint gets no handle, take an explicit timed
lock instead: CPU floor at the highest frequency, the GPU at its top
power level and the HMP scheduler boost for the hint duration (500 ms per
touch, renewed while the finger moves). The scheduler boost spreads
runnable threads to idle CPUs: without it the UI thread sat runnable
behind other threads for up to 8 ms of a 19 ms frame while a core idled.

Cluster 0 only: msm8917 has a single cluster, and perfd rejects a whole
request that names a cluster the SoC does not have ("Invalid logical
cluster id 1").

Measured on the T3 10 (notification shade, atrace):
- real finger drags, CPU/GPU part: the lock lands 5-6 ms after the first
  touch and releases ~0.5 s after the last. Before, 3 of 6 drags ran at
  the low clock with the UI thread at ~14 ms per frame (p50) and HWUI
  reported 49% janky frames; with the lock the CPU stays at 1.4 GHz for
  the whole drag, UI thread p50 4.3 ms, 14% janky.
- scheduler boost on top (5 scripted pulls, repeated): RenderThread p50
  10.4-13.3 -> 8.8-9.0 ms, RenderThread frames over 16.7 ms 29-55 -> 9-10,
  UI thread p50 8.3-8.8 -> 5.7-6.2 ms; time the UI and render threads
  spent runnable but not running about halved.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Ie8784b0887e1fcb6821eaeb76198a129e0b6719f
---
 power-8937.c | 37 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 36 insertions(+), 1 deletion(-)

diff --git a/power-8937.c b/power-8937.c
index b28e2c7..08425d5 100644
--- a/power-8937.c
+++ b/power-8937.c
@@ -60,6 +60,29 @@ const int kMinInteractiveDuration = 500;  /* ms */
 const int kMaxInteractiveDuration = 5000; /* ms */
 const int kMaxLaunchDuration = 5000;      /* ms */
 
+/*
+ * Explicit perf locks for the touch and launch boosts, used when perfd does not take the vendor
+ * hints. Some vendor perfd clients (e.g. Huawei's Oreo libqti-perfd-client on msm8917) export
+ * only perf_lock_*: there is no perf_hint, so the hints were silent no-ops and a drag started at
+ * the minimum CPU clock. Cluster 0 only: msm8917 has a single cluster, and perfd rejects a whole
+ * request that names a cluster the SoC does not have. 0xFFF = the highest available frequency.
+ * SCHED_BOOST: the HMP scheduler spreads runnable tasks to idle CPUs instead of queueing them
+ * behind a busy one (the UI thread waited for a CPU while another was idle).
+ */
+// clang-format off
+static int interaction_boost_resources[] = {
+    SCHED_BOOST_ON_V3, 0x1,
+    MIN_FREQ_BIG_CORE_0, 0xFFF,
+    GPU_MIN_POWER_LEVEL, 0x0,
+};
+
+static int launch_boost_resources[] = {
+    SCHED_BOOST_ON_V3, 0x1,
+    MIN_FREQ_BIG_CORE_0, 0xFFF,
+    GPU_MIN_POWER_LEVEL, 0x0,
+};
+// clang-format on
+
 static int current_power_profile = PROFILE_BALANCED;
 
 // clang-format off
@@ -275,7 +298,14 @@ static void process_interaction_hint(void* data) {
     s_previous_boost_timespec = cur_boost_timespec;
     s_previous_duration = duration;
 
-    perf_hint_enable_with_type(VENDOR_HINT_SCROLL_BOOST, duration, SCROLL_VERTICAL);
+    if (!CHECK_HANDLE(perf_hint_enable_with_type(VENDOR_HINT_SCROLL_BOOST, duration,
+                                                 SCROLL_VERTICAL))) {
+        static int interaction_handle = 0;
+        if (!CHECK_HANDLE(interaction_handle)) interaction_handle = 0;  // -1: last acquire failed
+        interaction_handle = interaction_with_handle(interaction_handle, duration,
+                                                     ARRAY_SIZE(interaction_boost_resources),
+                                                     interaction_boost_resources);
+    }
 }
 
 static int process_activity_launch_hint(void* data) {
@@ -295,6 +325,11 @@ static int process_activity_launch_hint(void* data) {
     if (!launch_mode) {
         launch_handle = perf_hint_enable_with_type(VENDOR_HINT_FIRST_LAUNCH_BOOST,
                                                    kMaxLaunchDuration, LAUNCH_BOOST_V1);
+        if (!CHECK_HANDLE(launch_handle)) {
+            launch_handle = interaction_with_handle(0, kMaxLaunchDuration,
+                                                    ARRAY_SIZE(launch_boost_resources),
+                                                    launch_boost_resources);
+        }
         if (!CHECK_HANDLE(launch_handle)) {
             ALOGE("Failed to perform launch boost");
             return HINT_NONE;
-- 
2.53.0

