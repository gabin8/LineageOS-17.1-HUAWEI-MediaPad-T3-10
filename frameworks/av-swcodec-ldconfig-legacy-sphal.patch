From 605f56cc4923872b7c15697221852f05015e6c27 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Wed, 4 Nov 2026 00:49:27 +0200
Subject: [PATCH] media.swcodec ld.config: sphal may load system libs on legacy
 devices

On a non-VNDK (legacy) build there are no vndk-sp libraries, so the vendor
gralloc mapper could not be loaded in the swcodec APEX's sphal namespace
and mediaswcodec aborted ("gralloc-mapper is missing") whenever a Codec2
software video decoder got an output surface (e.g. VP9). Search
/system/${LIB} first, like the system's legacy linker config.

Change-Id: Iae7538eacfb5d34e67145fcb52006ed6a3aefa72
---
 apex/ld.config.txt | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/apex/ld.config.txt b/apex/ld.config.txt
index af8ec06..5f61793 100644
--- a/apex/ld.config.txt
+++ b/apex/ld.config.txt
@@ -65,10 +65,16 @@ namespace.sphal.visible = true
 # Keep the below in sync with "sphal" namespace in system's /etc/ld.config.txt
 # Codec2 has dependencies on some SP-hals (eg. android.hardware.graphics.mapper@2.0)
 # These are dlopen'ed by libvndksupport.so.
-namespace.sphal.search.paths  = /odm/${LIB}
+# Legacy (non-VNDK, non-Treble) devices: vendor HALs such as the gralloc mapper link the system's
+# libutils/libhidlbase/... (no vndk-sp copies exist), as with the system linker's legacy config.
+# Search /system first: old vendor trees may carry stale copies of those libraries. Without this
+# the software codecs abort with "gralloc-mapper is missing" as soon as a video has a surface.
+namespace.sphal.search.paths  = /system/${LIB}
+namespace.sphal.search.paths += /odm/${LIB}
 namespace.sphal.search.paths += /vendor/${LIB}
 
-namespace.sphal.permitted.paths  = /odm/${LIB}
+namespace.sphal.permitted.paths  = /system/${LIB}
+namespace.sphal.permitted.paths += /odm/${LIB}
 namespace.sphal.permitted.paths += /vendor/${LIB}
 namespace.sphal.permitted.paths += /vendor/${LIB}/hw
 namespace.sphal.permitted.paths += /system/vendor/${LIB}
