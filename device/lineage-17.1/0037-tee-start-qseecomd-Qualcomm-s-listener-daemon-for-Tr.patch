From ee9ab9dfb76739ef9e44ef60e87d78ad66fb6311 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Fri, 6 Nov 2026 18:29:36 +0200
Subject: [PATCH] tee: start qseecomd, Qualcomm's listener daemon for TrustZone
 apps

Stock started it from the vendor init.target.rc, which this port does
not import on Android 10, so it never ran: TrustZone apps had no access
to their storage (eMMC RPMB, the ssd partition, /persist), time or
interrupt services. init.ags_w09.tee.rc (vendor, installed by stage A2)
starts it like stock. Its Oreo build sets the unprefixed
sys.listeners.registered and sys.keymaster.loaded: label them like
vendor.sys.listeners.registered, which its policy may set.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 product/init.mk             | 4 ++++
 rootdir/Android.mk          | 8 ++++++++
 rootdir/init.ags_w09.tee.rc | 8 ++++++++
 sepolicy/property_contexts  | 3 +++
 4 files changed, 23 insertions(+)
 create mode 100644 rootdir/init.ags_w09.tee.rc

diff --git a/product/init.mk b/product/init.mk
index e7002bc..82090aa 100644
--- a/product/init.mk
+++ b/product/init.mk
@@ -7,6 +7,10 @@ PRODUCT_PACKAGES += \
     init.wifi.sh \
     init.wifi_mac.sh
 
+# QSEECom listener daemon for TrustZone apps (stock started it from init.target.rc)
+PRODUCT_PACKAGES += \
+    init.ags_w09.tee.rc
+
 # Vendor helper scripts
 PRODUCT_PACKAGES += \
     init.qcom.sh \
diff --git a/rootdir/Android.mk b/rootdir/Android.mk
index e2e6cfa..8b30e32 100644
--- a/rootdir/Android.mk
+++ b/rootdir/Android.mk
@@ -57,6 +57,14 @@ LOCAL_MODULE_PATH  := $(TARGET_OUT_VENDOR_ETC)/init
 include $(BUILD_PREBUILT)
 
 # Modem helpers and holder (GNSS runs on the modem DSP), likewise in /vendor/etc/init.
+include $(CLEAR_VARS)
+LOCAL_MODULE       := init.ags_w09.tee.rc
+LOCAL_MODULE_TAGS  := optional
+LOCAL_MODULE_CLASS := ETC
+LOCAL_SRC_FILES    := init.ags_w09.tee.rc
+LOCAL_MODULE_PATH  := $(TARGET_OUT_VENDOR_ETC)/init
+include $(BUILD_PREBUILT)
+
 include $(CLEAR_VARS)
 LOCAL_MODULE       := init.ags_w09.modem.rc
 LOCAL_MODULE_TAGS  := optional
diff --git a/rootdir/init.ags_w09.tee.rc b/rootdir/init.ags_w09.tee.rc
new file mode 100644
index 0000000..28d97b4
--- /dev/null
+++ b/rootdir/init.ags_w09.tee.rc
@@ -0,0 +1,8 @@
+# Qualcomm's QSEECom listener daemon, as stock started it (EMUI's vendor init.target.rc, which this
+# port does not import on Android 10). TrustZone apps cannot reach storage themselves: qseecomd
+# serves their requests for the eMMC's replay-protected block (RPMB), the ssd partition, /persist
+# and time, and sets sys.listeners.registered once its listeners are up.
+service qseecomd /vendor/bin/qseecomd
+    class core
+    user root
+    group root
diff --git a/sepolicy/property_contexts b/sepolicy/property_contexts
index 541d31b..a7d9cb9 100644
--- a/sepolicy/property_contexts
+++ b/sepolicy/property_contexts
@@ -5,3 +5,6 @@ ro.min_freq_                    u:object_r:freq_prop:s0
 sys.post_boot.parsed            u:object_r:vendor_mpctl_prop:s0
 # libbt-vendor (Oreo prebuilt): the unprefixed names of vendor.wc_transport.*
 wc_transport.                   u:object_r:vendor_bluetooth_prop:s0
+# qseecomd (Oreo prebuilt): the unprefixed names of vendor.sys.listeners.registered
+sys.listeners.registered        u:object_r:vendor_tee_listener_prop:s0
+sys.keymaster.loaded            u:object_r:vendor_tee_listener_prop:s0
-- 
2.53.0

