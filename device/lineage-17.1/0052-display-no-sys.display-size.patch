From 2fa7ea96a05a0f9e083f95670d1b06dbd47f6faf Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Sun, 8 Nov 2026 15:13:51 +0200
Subject: [PATCH] display: no sys.display-size

The first template set sys.display-size=3840x2160, a value for Qualcomm
reference boards with 4K output. Nothing on this tablet reads it (no
vendor or system binary uses it, and stock EMUI never set it), but
hardware-info apps such as AIDA64 report it as the screen: a 3840x2160,
28-inch display instead of the 800x1280, 9.6-inch panel.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016iwHzV2tPonTxdceSkWZtS
---
 product/display.mk | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/product/display.mk b/product/display.mk
index fe4e737..1065904 100644
--- a/product/display.mk
+++ b/product/display.mk
@@ -65,8 +65,7 @@ PRODUCT_PROPERTY_OVERRIDES += \
     ro.sf.lcd_density=213 \
     sdm.debug.disable_rotator_split=1 \
     sdm.debug.disable_skip_validate=1 \
-    sdm.perf_hint_window=50 \
-    sys.display-size=3840x2160
+    sdm.perf_hint_window=50
 
 # RenderScript HAL
 PRODUCT_PACKAGES += \
-- 
2.53.0

