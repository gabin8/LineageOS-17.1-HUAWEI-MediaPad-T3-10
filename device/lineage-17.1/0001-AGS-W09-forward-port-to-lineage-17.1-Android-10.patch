--- /dev/null
+++ b/board/android10.mk
@@ -0,0 +1,16 @@
+# Android 10 (lineage-17.1), legacy non-Treble build: no VNDK, monolithic /sepolicy in the
+# ramdisk, legacy linker config. The prebuilt vendor is an EMUI 8 (Android 8.0) one.
+
+# APEX modules as flat directories (no loop-mounted images on this 3.18 kernel)
+TARGET_FLATTEN_APEX := true
+
+# Mount points created in the boot ramdisk for the second-stage mount_all
+BOARD_ROOT_EXTRA_FOLDERS := firmware persist
+
+# Device props that must reach /system/build.prop (the vendor image is not rebuilt in
+# stage A, and PRODUCT_PROPERTY_OVERRIDES land in /vendor/build.prop on this build)
+TARGET_SYSTEM_PROP += $(DEVICE_PATH)/system.prop
+
+# Bring-up only (Phase 1-3, permissive): let the 15.1 device policy compile against Q's
+# neverallows. Only honoured on userdebug/eng. Remove for SELinux enforcing (Phase 4).
+SELINUX_IGNORE_NEVERALLOWS := true
