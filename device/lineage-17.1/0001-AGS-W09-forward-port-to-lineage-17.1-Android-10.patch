+# Android 10 (legacy, non-Treble) layout for the AGS-W09:
+#  - boot ramdisk: fstab.qcom (first-stage mount of system + vendor), init.qcom.rc (all device
+#    services; the prebuilt EMUI vendor's own /vendor/etc/init/hw/init.qcom.rc is neutralised),
+#    ueventd.qcom.rc (read last by ueventd, so it overrides /vendor/ueventd.rc), WiFi bring-up.
+#  - /vendor/bin: the Qualcomm helper scripts (vendor image only).
+
+define ags_w09_root_prebuilt
+include $$(CLEAR_VARS)
+LOCAL_MODULE       := $(1)
+LOCAL_MODULE_TAGS  := optional
+LOCAL_MODULE_CLASS := ETC
+LOCAL_SRC_FILES    := $(1)
+LOCAL_MODULE_PATH  := $$(TARGET_ROOT_OUT)
+include $$(BUILD_PREBUILT)
+endef
+
+$(eval $(call ags_w09_root_prebuilt,fstab.qcom))
+$(eval $(call ags_w09_root_prebuilt,init.qcom.rc))
+$(eval $(call ags_w09_root_prebuilt,ueventd.qcom.rc))
+$(eval $(call ags_w09_root_prebuilt,init.wifi.sh))
+$(eval $(call ags_w09_root_prebuilt,init.wifi_mac.sh))
+
+define ags_w09_vendor_script
+include $$(CLEAR_VARS)
+LOCAL_MODULE       := $(1)
+LOCAL_MODULE_TAGS  := optional
+LOCAL_MODULE_CLASS := ETC
+LOCAL_SRC_FILES    := $(1)
+LOCAL_MODULE_PATH  := $$(TARGET_OUT_VENDOR_EXECUTABLES)
+include $$(BUILD_PREBUILT)
+endef
+
+$(eval $(call ags_w09_vendor_script,init.qcom.sh))
+$(eval $(call ags_w09_vendor_script,init.qcom.baseband.sh))
+$(eval $(call ags_w09_vendor_script,init.qcom.graphics.sh))
+$(eval $(call ags_w09_vendor_script,init.qcom.usb.sh))
