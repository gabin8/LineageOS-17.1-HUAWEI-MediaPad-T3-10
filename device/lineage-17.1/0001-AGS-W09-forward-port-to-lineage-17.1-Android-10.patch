+
+# Huawei agassi ACDB calibration for the audio HAL (libacdbloader reads
+# /product/etc/acdbdata/agassi). On Android 10 /product is /system/product, so the files ship
+# in system instead of mounting Huawei's product partition (handoff 5, decision 4). Extracted
+# from the stock product image with the +6 dB recording boost already applied
+# (vendor/apply-recording-boost.sh, 15.1 fix 61).
+PRODUCT_COPY_FILES += \
+    $(call find-copy-subdir-files,*,vendor/huawei/ags_w09/proprietary/product/etc/acdbdata/agassi,$(TARGET_COPY_OUT_PRODUCT)/etc/acdbdata/agassi)
