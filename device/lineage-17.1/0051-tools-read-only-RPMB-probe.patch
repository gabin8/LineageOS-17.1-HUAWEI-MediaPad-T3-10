From 9f73105f9b7b71412866ff94be060efdabdbf277 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Sun, 8 Nov 2026 01:03:14 +0200
Subject: [PATCH 51/51] tools: read-only RPMB probe

Bench tool, not installed: reads the eMMC RPMB write counter and frames
through MMC_IOC_RPMB_CMD (read-counter and authenticated-read requests
only, never a write). Used to show that the TrustZone keymaster wrote the
RPMB records stock depends on, and that the software keystore writes none.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016iwHzV2tPonTxdceSkWZtS
---
 tools/rpmb_probe/Android.bp     |  7 +++
 tools/rpmb_probe/rpmb_probe.cpp | 76 +++++++++++++++++++++++++++++++++
 2 files changed, 83 insertions(+)
 create mode 100644 tools/rpmb_probe/Android.bp
 create mode 100644 tools/rpmb_probe/rpmb_probe.cpp

diff --git a/tools/rpmb_probe/Android.bp b/tools/rpmb_probe/Android.bp
new file mode 100644
index 0000000..13dfe27
--- /dev/null
+++ b/tools/rpmb_probe/Android.bp
@@ -0,0 +1,7 @@
+// Bench test tool, not installed by the product: m rpmb_probe, push and run as root.
+cc_binary {
+    name: "rpmb_probe",
+    vendor: true,
+    srcs: ["rpmb_probe.cpp"],
+    cflags: ["-Wall", "-Werror"],
+}
diff --git a/tools/rpmb_probe/rpmb_probe.cpp b/tools/rpmb_probe/rpmb_probe.cpp
new file mode 100644
index 0000000..e7a3e7a
--- /dev/null
+++ b/tools/rpmb_probe/rpmb_probe.cpp
@@ -0,0 +1,76 @@
+// Read-only eMMC RPMB probe (Qualcomm MMC_IOC_RPMB_CMD, as qseecomd uses). Never writes RPMB:
+// only "read write counter" (0x0002) and "authenticated data read" (0x0004) requests; the MAC in
+// the responses is not verified (no key needed to read).
+//   rpmb_probe counter              print the RPMB write counter
+//   rpmb_probe dump <out> [frames]  read all (or N) 256-byte frames to <out>, print the counter
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/major.h>
+#include <linux/mmc/ioctl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#ifndef MMC_IOC_MAX_RPMB_CMD
+#define MMC_IOC_MAX_RPMB_CMD 3
+struct mmc_ioc_rpmb { struct mmc_ioc_cmd cmds[MMC_IOC_MAX_RPMB_CMD]; };
+#define MMC_IOC_RPMB_CMD _IOWR(MMC_BLOCK_MAJOR, 0, struct mmc_ioc_rpmb)
+#endif
+static const unsigned kFlags = 0x35;  // MMC_RSP_R1 | MMC_CMD_ADTC
+struct Frame { uint8_t stuff[196], mac[32], data[256], nonce[16], wc[4], addr[2], cnt[2], res[2], req[2]; };
+static_assert(sizeof(Frame) == 512, "frame");
+static int fd;
+
+static int Request(uint16_t type, uint16_t addr, Frame* resp, unsigned nresp) {
+    Frame req = {};
+    req.req[0] = type >> 8; req.req[1] = type & 0xff;
+    req.addr[0] = addr >> 8; req.addr[1] = addr & 0xff;
+    for (int i = 0; i < 16; i++) req.nonce[i] = (uint8_t)rand();
+    mmc_ioc_rpmb r = {};
+    r.cmds[0].write_flag = 1; r.cmds[0].opcode = 25; r.cmds[0].flags = kFlags;
+    r.cmds[0].blksz = 512; r.cmds[0].blocks = 1; mmc_ioc_cmd_set_data(r.cmds[0], &req);
+    r.cmds[1].write_flag = 0; r.cmds[1].opcode = 18; r.cmds[1].flags = kFlags;
+    r.cmds[1].blksz = 512; r.cmds[1].blocks = nresp; mmc_ioc_cmd_set_data(r.cmds[1], resp);
+    if (ioctl(fd, MMC_IOC_RPMB_CMD, &r) < 0) { perror("MMC_IOC_RPMB_CMD"); return -1; }
+    uint16_t result = (resp[0].res[0] << 8) | resp[0].res[1];
+    if (result & 0x7f) { fprintf(stderr, "rpmb result 0x%04x\n", result); return -1; }
+    return 0;
+}
+static long Counter() {
+    Frame f[1] = {};
+    if (Request(0x0002, 0, f, 1)) return -1;
+    return ((long)f[0].wc[0] << 24) | (f[0].wc[1] << 16) | (f[0].wc[2] << 8) | f[0].wc[3];
+}
+
+int main(int argc, char** argv) {
+    if (argc < 2) { fprintf(stderr, "usage: rpmb_probe counter | dump <out> [frames]\n"); return 2; }
+    srand(getpid());
+    fd = open("/dev/block/mmcblk0rpmb", O_RDWR);
+    if (fd < 0) { perror("open /dev/block/mmcblk0rpmb"); return 1; }
+    long c = Counter();
+    printf("write counter: %ld\n", c);
+    if (strcmp(argv[1], "dump") || argc < 3) return c < 0;
+    long frames = argc > 3 ? atol(argv[3]) : 0;
+    if (!frames) {   // RPMB size from sysfs (512-byte sectors) -> 256-byte frames
+        FILE* s = fopen("/sys/block/mmcblk0rpmb/size", "r");
+        long sectors = 0;
+        if (s) { if (fscanf(s, "%ld", &sectors) != 1) sectors = 0; fclose(s); }
+        frames = sectors * 2;
+    }
+    FILE* out = fopen(argv[2], "wb");
+    if (!out) { perror(argv[2]); return 1; }
+    const unsigned kChunk = 16;
+    static Frame buf[kChunk];
+    for (long a = 0; a < frames; a += kChunk) {
+        unsigned n = (frames - a) < kChunk ? (unsigned)(frames - a) : kChunk;
+        memset(buf, 0, sizeof(buf));
+        if (Request(0x0004, (uint16_t)a, buf, n)) { fprintf(stderr, "read failed at frame %ld\n", a); return 1; }
+        for (unsigned i = 0; i < n; i++) fwrite(buf[i].data, 1, 256, out);
+    }
+    fclose(out);
+    printf("dumped %ld frames (%ld bytes); write counter after: %ld\n", frames, frames * 256, Counter());
+    return 0;
+}
