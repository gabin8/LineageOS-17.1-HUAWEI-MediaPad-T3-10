From 8dee0c2d6fb7f92950b9fbb5cd4afd3df993bad9 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Tue, 3 Nov 2026 16:21:14 +0200
Subject: [PATCH 03/20] AGS-W09: libinit_msm8917 as a Soong module (Q libinit
 is Soong)

---
 board/init.mk   |  1 -
 init/Android.bp | 12 ++++++++++++
 init/Android.mk | 35 -----------------------------------
 3 files changed, 12 insertions(+), 36 deletions(-)
 create mode 100644 init/Android.bp
 delete mode 100644 init/Android.mk

diff --git a/board/init.mk b/board/init.mk
index b1acdd8..574c014 100644
--- a/board/init.mk
+++ b/board/init.mk
@@ -1,3 +1,2 @@
 # Init
 TARGET_INIT_VENDOR_LIB := libinit_msm8917
-TARGET_RECOVERY_DEVICE_MODULES := libinit_msm8917
diff --git a/init/Android.bp b/init/Android.bp
new file mode 100644
index 0000000..eef7cac
--- /dev/null
+++ b/init/Android.bp
@@ -0,0 +1,12 @@
+// Vendor init hook for libinit (system/core/init, lineage soong variable target_init_vendor_lib).
+cc_library_static {
+    name: "libinit_msm8917",
+    recovery_available: true,
+    srcs: ["init_msm8917.cpp"],
+    cflags: ["-Wall"],
+    whole_static_libs: ["libbase"],
+    include_dirs: [
+        "system/core/base/include",
+        "system/core/init",
+    ],
+}
diff --git a/init/Android.mk b/init/Android.mk
deleted file mode 100644
index f3a5432..0000000
--- a/init/Android.mk
+++ /dev/null
@@ -1,35 +0,0 @@
