-LOCAL_PATH := $(call my-dir)
-
-include $(CLEAR_VARS)
-
-LOCAL_C_INCLUDES := \
-    system/core/base/include \
-    system/core/init
-LOCAL_CFLAGS := -Wall
-LOCAL_MODULE_TAGS := optional
-LOCAL_SRC_FILES := init_msm8917.cpp
-LOCAL_STATIC_LIBRARIES := \
-    libbase
-
-ifneq ($(TARGET_LIBINIT_MSM8917_DEFINES_FILE),)
-    LOCAL_SRC_FILES += ../../../../$(TARGET_LIBINIT_MSM8917_DEFINES_FILE)
-endif
-LOCAL_MODULE := libinit_msm8917
-
-include $(BUILD_STATIC_LIBRARY)
