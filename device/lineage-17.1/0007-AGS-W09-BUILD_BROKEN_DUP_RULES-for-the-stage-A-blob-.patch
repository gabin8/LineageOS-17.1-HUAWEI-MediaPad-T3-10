From 9742ba96ea0d43fdc7339ae32792c1fc5b2f2c42 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Tue, 3 Nov 2026 16:27:02 +0200
Subject: [PATCH 07/20] AGS-W09: BUILD_BROKEN_DUP_RULES for the stage A blob
 overlaps

---
 board/android10.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/board/android10.mk b/board/android10.mk
index 05f91e9..e4f8187 100644
--- a/board/android10.mk
+++ b/board/android10.mk
@@ -14,3 +14,8 @@ TARGET_SYSTEM_PROP += $(DEVICE_PATH)/system.prop
 # Bring-up only (Phase 1-3, permissive): let the 15.1 device policy compile against Q's
 # neverallows. Only honoured on userdebug/eng. Remove for SELinux enforcing (Phase 4).
 SELINUX_IGNORE_NEVERALLOWS := true
+
+# Stage A: the blob list (PRODUCT_COPY_FILES) overlaps modules Q builds from source (media,
+# display...). Only the vendor image is affected and it is not flashed in stage A; the copied
+# blob wins. Stage B (vendor rebuilt from the EMUI 8 image) removes the overlaps instead.
+BUILD_BROKEN_DUP_RULES := true
