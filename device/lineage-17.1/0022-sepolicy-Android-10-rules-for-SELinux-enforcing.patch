From fee5ed66f31cb3a44fc04b7bba80234a3525fb9d Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Wed, 4 Nov 2026 18:04:14 +0200
Subject: [PATCH 22/23] sepolicy: Android 10 rules for SELinux enforcing

Denials collected over a boot and a feature walk-through (Wi-Fi, audio
play/record, both cameras, video record/play, sensors, browser, apps,
settings, screen off/on) with the audit rate limit lifted, then tested
live (load_policy + setenforce 1) and with enforcing boots. The 15.1
rules (fix 35) carried over; these are what the Android 10 system added:

- Labels instead of broad allows: SMB1360 battery/BMS power_supply ->
  sysfs_batteryinfo (healthd, thermal-engine system_temp_level), eMMC
  stat -> sysfs_disk_stat (storaged), firmware_class path, the ADSP
  subsystem restart_level, the legacy USB gadget (AOSP init.usb.rc
  chowns lun/file) -> sysfs_android_usb, and /dev/stune -> cgroup
  (cgroups.json creates it, this 3.18 kernel has no schedtune: the
  plain tmpfs dirs stand in for the cgroup, writes are no-ops).
- post_boot properties: ro.min_freq_* -> freq_prop,
  sys.post_boot.parsed -> vendor_mpctl_prop (set by the post-boot
  script, read by perfd).
- Sensors: both sensor processes search /persist (without it the HAL
  comes up with "No Sensors" under enforcing: no auto-rotate).
- init: /init.qcom.rc writes (firmware path, boot_adsp, restart_level
  "related" = restart the ADSP instead of the whole device, chowns).
- Oreo vendor daemons (thermal-engine, time_daemon, sensors, perfd,
  irsc_util, qti_init_shell, vndservicemanager, wcnss_service): /vendor
  root listing, dac_override where they run as root on others' files,
  WCNSS config + wlan.driver.config, time_daemon's /data/time.
- The Adreno driver reads the GPU clock in every rendering process.
- Audio HAL: Android 10's system libcutils asks ashmemd through the
  system servicemanager first; keep that denied (vendor HAL on
  /dev/binder) but quiet, it falls back to /dev/ashmem.
- print-fatal-signals: quietly denied until the system image drops the
  debug write.

Result: enforcing boot with 0 denials; the walk-through passes with 0
denials, crashes or ANRs (photos, 1080p video with sound, recording,
Wi-Fi reconnect, 14 sensors/rotation, HW video decode).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sepolicy/appdomain.te         |  3 +++
 sepolicy/file.te              |  3 +++
 sepolicy/file_contexts        |  4 ++++
 sepolicy/genfs_contexts       |  8 ++++++++
 sepolicy/hal_audio_default.te |  6 ++++++
 sepolicy/hal_wifi_default.te  |  1 +
 sepolicy/init.te              | 11 +++++++++++
 sepolicy/oeminfo_nvm.te       |  1 +
 sepolicy/perfd.te             |  1 +
 sepolicy/property_contexts    |  3 +++
 sepolicy/qti_init_shell.te    |  3 +++
 sepolicy/sensors.te           |  4 ++++
 sepolicy/thermal-engine.te    |  4 ++++
 sepolicy/time_daemon.te       |  4 ++++
 sepolicy/ueventd.te           |  2 ++
 sepolicy/vendor_dir.te        |  2 ++
 sepolicy/vendor_init.te       |  1 +
 sepolicy/wcnss_service.te     |  4 ++++
 sepolicy/wifi_bringup.te      |  1 +
 19 files changed, 66 insertions(+)
 create mode 100644 sepolicy/appdomain.te
 create mode 100644 sepolicy/init.te
 create mode 100644 sepolicy/sensors.te
 create mode 100644 sepolicy/time_daemon.te
 create mode 100644 sepolicy/ueventd.te
 create mode 100644 sepolicy/vendor_dir.te
 create mode 100644 sepolicy/vendor_init.te

diff --git a/sepolicy/appdomain.te b/sepolicy/appdomain.te
new file mode 100644
index 0000000..aeaed33
--- /dev/null
+++ b/sepolicy/appdomain.te
@@ -0,0 +1,3 @@
+# The Adreno driver (libGLES) reads the GPU clock in every process that renders.
+allow { appdomain bootanim surfaceflinger } sysfs_kgsl:dir search;
+allow { appdomain bootanim surfaceflinger } sysfs_kgsl:file r_file_perms;
diff --git a/sepolicy/file.te b/sepolicy/file.te
index 6474369..1044ed4 100644
--- a/sepolicy/file.te
+++ b/sepolicy/file.te
@@ -1,3 +1,6 @@
 type proc_wifi_built_in, fs_type;
 type sysfs_hw_audio_info, fs_type, sysfs_type;
 type sysfs_lcd_cabc, fs_type, sysfs_type;
+type sysfs_firmware_class_path, fs_type, sysfs_type;
+type proc_print_fatal_signals, fs_type, proc_type;
+type sysfs_ssr_restart_level, fs_type, sysfs_type;
diff --git a/sepolicy/file_contexts b/sepolicy/file_contexts
index 43130b3..36e6912 100644
--- a/sepolicy/file_contexts
+++ b/sepolicy/file_contexts
@@ -38,3 +38,7 @@
 # /file_contexts.bin there, and Q dropped its label (Oreo had this one).
 /file_contexts\.bin                         u:object_r:file_contexts_file:s0
 /firmware                                   u:object_r:firmware_file:s0
+
+# Android 10's cgroups.json creates /dev/stune, but this 3.18 kernel has no schedtune, so the
+# directories stay plain tmpfs. Label them as the cgroup they stand in for (writes are no-ops).
+/dev/stune(/.*)?                            u:object_r:cgroup:s0
diff --git a/sepolicy/genfs_contexts b/sepolicy/genfs_contexts
index 3903b51..db1c997 100644
--- a/sepolicy/genfs_contexts
+++ b/sepolicy/genfs_contexts
@@ -2,3 +2,11 @@ genfscon proc /wifi_built_in u:object_r:proc_wifi_built_in:s0
 genfscon sysfs /bus/platform/drivers/hw_audio_info/hw_audio_info u:object_r:sysfs_hw_audio_info:s0
 genfscon sysfs /devices/soc/soc:gpio-leds/leds u:object_r:sysfs_leds:s0
 genfscon sysfs /devices/virtual/graphics/fb0/lcd_cabc_mode u:object_r:sysfs_lcd_cabc:s0
+# SMB1360 charger + BMS power_supply nodes (healthd, thermal-engine's system_temp_level)
+genfscon sysfs /devices/soc/78b6000.i2c/i2c-2/2-0014/power_supply u:object_r:sysfs_batteryinfo:s0
+genfscon sysfs /devices/soc/7824900.sdhci/mmc_host/mmc0/mmc0:0001/block/mmcblk0/stat u:object_r:sysfs_disk_stat:s0
+genfscon sysfs /module/firmware_class/parameters/path u:object_r:sysfs_firmware_class_path:s0
+# legacy USB gadget (AOSP init.usb.rc chowns f_mass_storage/lun/file, which resolves here)
+genfscon sysfs /devices/soc/78db000.usb/msm_hsusb/gadget u:object_r:sysfs_android_usb:s0
+genfscon proc /sys/kernel/print-fatal-signals u:object_r:proc_print_fatal_signals:s0
+genfscon sysfs /devices/soc/c200000.qcom,lpass/subsys1/restart_level u:object_r:sysfs_ssr_restart_level:s0
diff --git a/sepolicy/hal_audio_default.te b/sepolicy/hal_audio_default.te
index 051f726..3b18103 100644
--- a/sepolicy/hal_audio_default.te
+++ b/sepolicy/hal_audio_default.te
@@ -1,2 +1,8 @@
 allow hal_audio_default sysfs_hw_audio_info:dir search;
 allow hal_audio_default sysfs_hw_audio_info:file r_file_perms;
+
+# Android 10's libcutils (the system copy, on this non-VNDK build) asks ashmemd through the system
+# servicemanager first and falls back to /dev/ashmem. A vendor HAL has no business on /dev/binder:
+# keep the call denied, quietly, and let the fallback work.
+dontaudit hal_audio_default servicemanager:binder call;
+allow hal_audio_default sysfs:dir r_dir_perms;
diff --git a/sepolicy/hal_wifi_default.te b/sepolicy/hal_wifi_default.te
index 100848b..4f7e8ee 100644
--- a/sepolicy/hal_wifi_default.te
+++ b/sepolicy/hal_wifi_default.te
@@ -1,2 +1,3 @@
 allow hal_wifi_default proc_wifi_built_in:dir search;
 allow hal_wifi_default proc_wifi_built_in:file w_file_perms;
+allow hal_wifi_default proc_net:file w_file_perms;    # tcp_limit_output_bytes
diff --git a/sepolicy/init.te b/sepolicy/init.te
new file mode 100644
index 0000000..e4c06cf
--- /dev/null
+++ b/sepolicy/init.te
@@ -0,0 +1,11 @@
+# /init.qcom.rc (system root on Android 10, run by init)
+allow init firmware_file:filesystem getattr;
+allow init sysfs_firmware_class_path:file { w_file_perms setattr };
+allow init sysfs_boot_adsp:file w_file_perms;
+allow init { sysfs_lcd_cabc sysfs_wlan_fwpath }:file setattr;
+allow init vendor_block_device:lnk_file relabelto;
+allow init sysfs_android_usb:file setattr;
+# The system image's init.qcom.rc still sets print-fatal-signals (a bring-up debug knob, dropped
+# from the tree); keep it at the kernel default, quietly, until the next system build.
+dontaudit init proc_print_fatal_signals:file { open write };
+allow init sysfs_ssr_restart_level:file w_file_perms;    # ADSP: restart_level related (not a full reboot)
diff --git a/sepolicy/oeminfo_nvm.te b/sepolicy/oeminfo_nvm.te
index 66190db..a7b7352 100644
--- a/sepolicy/oeminfo_nvm.te
+++ b/sepolicy/oeminfo_nvm.te
@@ -21,3 +21,4 @@ allow oeminfo_nvm self:capability { chown fowner fsetid };
 unix_socket_connect(hal_sensors_default, oeminfo_nvm, oeminfo_nvm)
 allow hal_sensors_default oeminfo_nvm_device:dir rw_dir_perms;
 allow hal_sensors_default oeminfo_nvm_device:file { r_file_perms unlink };
+allowxperm oeminfo_nvm oeminfo_block_device:blk_file ioctl 0x1260;    # BLKGETSIZE
diff --git a/sepolicy/perfd.te b/sepolicy/perfd.te
index 8e8db85..0d8d513 100644
--- a/sepolicy/perfd.te
+++ b/sepolicy/perfd.te
@@ -42,3 +42,4 @@ unix_socket_connect(audioserver, mpctl, perfd)
 unix_socket_connect(surfaceflinger, mpctl, perfd)
 unix_socket_connect(hal_graphics_composer_default, mpctl, perfd)
 
+get_prop(perfd, vendor_mpctl_prop)    # waits for sys.post_boot.parsed
diff --git a/sepolicy/property_contexts b/sepolicy/property_contexts
index d2fa9b4..0b04b83 100644
--- a/sepolicy/property_contexts
+++ b/sepolicy/property_contexts
@@ -1,2 +1,5 @@
 persist.vendor.camera.		u:object_r:camera_prop:s0
 vendor.camera.			u:object_r:camera_prop:s0
+# init.qcom.post_boot.sh (Oreo vendor)
+ro.min_freq_                    u:object_r:freq_prop:s0
+sys.post_boot.parsed            u:object_r:vendor_mpctl_prop:s0
diff --git a/sepolicy/qti_init_shell.te b/sepolicy/qti_init_shell.te
index f97c5ef..40b0f6f 100644
--- a/sepolicy/qti_init_shell.te
+++ b/sepolicy/qti_init_shell.te
@@ -1 +1,4 @@
 allow qti_init_shell toolbox_exec:file { rx_file_perms execute_no_trans };
+set_prop(qti_init_shell, freq_prop)
+set_prop(qti_init_shell, vendor_mpctl_prop)
+allow qti_init_shell self:capability dac_override;
diff --git a/sepolicy/sensors.te b/sepolicy/sensors.te
new file mode 100644
index 0000000..b61b17a
--- /dev/null
+++ b/sepolicy/sensors.te
@@ -0,0 +1,4 @@
+allow sensors persist_file:dir getattr;
+allow sensors self:capability dac_override;
+# /persist root (both sensor processes read /persist/sensors; without it: "No Sensors")
+allow { sensors hal_sensors_default } persist_file:dir search;
diff --git a/sepolicy/thermal-engine.te b/sepolicy/thermal-engine.te
index 90b9ff9..3be667d 100644
--- a/sepolicy/thermal-engine.te
+++ b/sepolicy/thermal-engine.te
@@ -1 +1,5 @@
 type_transition thermal-engine socket_device:sock_file thermal_socket;
+allow thermal-engine self:capability dac_override;
+allow thermal-engine sysfs:dir r_dir_perms;
+allow thermal-engine sysfs_batteryinfo:dir search;
+allow thermal-engine sysfs_batteryinfo:file rw_file_perms;    # battery/system_temp_level
diff --git a/sepolicy/time_daemon.te b/sepolicy/time_daemon.te
new file mode 100644
index 0000000..44df603
--- /dev/null
+++ b/sepolicy/time_daemon.te
@@ -0,0 +1,4 @@
+# The Oreo time_daemon keeps its state in /data/time and drops root itself.
+allow time_daemon self:capability { setuid setgid };
+allow time_daemon time_data_file:dir rw_dir_perms;
+allow time_daemon time_data_file:file create_file_perms;
diff --git a/sepolicy/ueventd.te b/sepolicy/ueventd.te
new file mode 100644
index 0000000..ee9bbd8
--- /dev/null
+++ b/sepolicy/ueventd.te
@@ -0,0 +1,2 @@
+allow ueventd self:capability sys_nice;
+allow ueventd persist_file:dir search;    # firmware lookup
diff --git a/sepolicy/vendor_dir.te b/sepolicy/vendor_dir.te
new file mode 100644
index 0000000..d489e4e
--- /dev/null
+++ b/sepolicy/vendor_dir.te
@@ -0,0 +1,2 @@
+# Oreo vendor daemons list the /vendor root directory.
+allow { irsc_util perfd qti_init_shell sensors thermal-engine time_daemon vndservicemanager } vendor_file:dir r_dir_perms;
diff --git a/sepolicy/vendor_init.te b/sepolicy/vendor_init.te
new file mode 100644
index 0000000..6fca266
--- /dev/null
+++ b/sepolicy/vendor_init.te
@@ -0,0 +1 @@
+allow vendor_init wifi_data_file:dir { search setattr };    # hostapd.android.rc: mkdir /data/misc/wifi/hostapd
diff --git a/sepolicy/wcnss_service.te b/sepolicy/wcnss_service.te
index 4580939..db04b80 100644
--- a/sepolicy/wcnss_service.te
+++ b/sepolicy/wcnss_service.te
@@ -1,3 +1,7 @@
 allow wcnss_service wifi_bringup:fd use;
 allow wcnss_service self:capability { chown dac_override fowner };
 dontaudit wcnss_service serialno_prop:file { getattr open read };
+set_prop(wcnss_service, wifi_prop)
+allow wcnss_service proc_cmdline:file r_file_perms;
+allow wcnss_service wifi_data_file:dir rw_dir_perms;
+allow wcnss_service wifi_data_file:file { create_file_perms setattr };    # WCNSS_qcom_cfg.ini
diff --git a/sepolicy/wifi_bringup.te b/sepolicy/wifi_bringup.te
index be42338..47751e8 100644
--- a/sepolicy/wifi_bringup.te
+++ b/sepolicy/wifi_bringup.te
@@ -17,3 +17,4 @@ allow wifi_bringup persist_file:dir search;
 
 domain_auto_trans(wifi_bringup, wcnss_service_exec, wcnss_service)
 allow wifi_bringup firmware_file:dir search;
+allow wifi_bringup sysfs_net:dir search;
