From 40e5b1a148e117e552fa81e1383018ae8ce7d460 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Thu, 5 Nov 2026 15:37:23 +0200
Subject: [PATCH] modem: boot the modem subsystem for the GNSS engine

On MSM8917 the GNSS engine runs on the modem DSP, also on this Wi-Fi
tablet (Huawei: GPS/GLONASS/BDS, no A-GPS on AGS-W09), but the port never
booted the modem. Start the stock helpers as stock EMUI did (rmt_storage
for the modem file system on modemst1/2, fsg, fsc; tftp_server) and keep
the modem up with ags_modem_holder, which holds /dev/subsys_modem open:
stock used pm-proxy's permanent vote through pm-service, but Huawei's
Android 8 libperipheral_client overflows Android 10's larger binder
Parcel on the stack (pm-proxy aborts in pm_register_connect). A modem
crash now restarts the modem only (restart level RELATED, as stock
production). The holder runs in the peripheral manager domain; modem.te
adds the rules the included Qualcomm policy lacks for these Android 8
binaries. The modem comes up ONLINE at boot and registers its QMI
location service.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 modem/Android.bp              |  7 +++++++
 modem/ags_modem_holder.c      | 27 +++++++++++++++++++++++++++
 product/gps.mk                |  5 +++++
 rootdir/Android.mk            |  9 +++++++++
 rootdir/init.ags_w09.modem.rc | 30 ++++++++++++++++++++++++++++++
 sepolicy/file_contexts        |  3 +++
 sepolicy/modem.te             | 13 +++++++++++++
 7 files changed, 94 insertions(+)
 create mode 100644 modem/Android.bp
 create mode 100644 modem/ags_modem_holder.c
 create mode 100644 rootdir/init.ags_w09.modem.rc
 create mode 100644 sepolicy/modem.te

diff --git a/modem/Android.bp b/modem/Android.bp
new file mode 100644
index 0000000..e16a560
--- /dev/null
+++ b/modem/Android.bp
@@ -0,0 +1,7 @@
+cc_binary {
+    name: "ags_modem_holder",
+    vendor: true,
+    srcs: ["ags_modem_holder.c"],
+    shared_libs: ["liblog"],
+    cflags: ["-Wall", "-Werror"],
+}
diff --git a/modem/ags_modem_holder.c b/modem/ags_modem_holder.c
new file mode 100644
index 0000000..0477e7d
--- /dev/null
+++ b/modem/ags_modem_holder.c
@@ -0,0 +1,27 @@
+/*
+ * Keeps the modem subsystem powered, and with it the GNSS engine, which runs on the modem DSP
+ * on MSM8917 (also on this Wi-Fi-only tablet). The kernel boots a subsystem on the first open of
+ * /dev/subsys_<name> and shuts it down on the last close. Stock EMUI held the modem up with
+ * pm-proxy's permanent vote through pm-service; Huawei's Android 8 libperipheral_client those use
+ * overflows Android 10's larger binder Parcel on the stack (pm-proxy aborts in
+ * pm_register_connect), so this holds the device node instead.
+ */
+#define LOG_TAG "ags_modem_holder"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <log/log.h>
+
+int main(void) {
+    /* Blocks until the modem is up (or its boot failed). */
+    int fd = open("/dev/subsys_modem", O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        ALOGE("open /dev/subsys_modem: %s", strerror(errno));
+        return 1;
+    }
+    ALOGI("modem is up; holding it");
+    for (;;) pause();
+}
diff --git a/product/gps.mk b/product/gps.mk
index 0814b56..89dfa26 100644
--- a/product/gps.mk
+++ b/product/gps.mk
@@ -18,3 +18,8 @@ PRODUCT_COPY_FILES += \
 # Permissions
 PRODUCT_COPY_FILES += \
     frameworks/native/data/etc/android.hardware.location.gps.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.location.gps.xml
+
+# Modem subsystem: the GNSS engine runs on the modem DSP (rootdir/init.ags_w09.modem.rc, modem/)
+PRODUCT_PACKAGES += \
+    ags_modem_holder \
+    init.ags_w09.modem.rc
diff --git a/rootdir/Android.mk b/rootdir/Android.mk
index 020de64..e2e6cfa 100644
--- a/rootdir/Android.mk
+++ b/rootdir/Android.mk
@@ -56,6 +56,15 @@ LOCAL_SRC_FILES    := init.ags_w09.bt.rc
 LOCAL_MODULE_PATH  := $(TARGET_OUT_VENDOR_ETC)/init
 include $(BUILD_PREBUILT)
 
+# Modem helpers and holder (GNSS runs on the modem DSP), likewise in /vendor/etc/init.
+include $(CLEAR_VARS)
+LOCAL_MODULE       := init.ags_w09.modem.rc
+LOCAL_MODULE_TAGS  := optional
+LOCAL_MODULE_CLASS := ETC
+LOCAL_SRC_FILES    := init.ags_w09.modem.rc
+LOCAL_MODULE_PATH  := $(TARGET_OUT_VENDOR_ETC)/init
+include $(BUILD_PREBUILT)
+
 define ags_w09_vendor_script
 include $$(CLEAR_VARS)
 LOCAL_MODULE       := $(1)
diff --git a/rootdir/init.ags_w09.modem.rc b/rootdir/init.ags_w09.modem.rc
new file mode 100644
index 0000000..4a93b9a
--- /dev/null
+++ b/rootdir/init.ags_w09.modem.rc
@@ -0,0 +1,30 @@
+# Modem subsystem, for the GNSS engine on its DSP (the tablet has no cellular radio). Stock EMUI ran
+# the same helpers from its vendor init.qcom.rc and init.target.rc. irsc_util (IPC router security
+# rules for the QMI services) already runs from init.qcom.rc.
+
+on early-boot
+    # A modem crash restarts the modem alone (stock production: persist.sys.ssr.restart_level
+    # ALL_ENABLE). The default, SYSTEM, panics the whole tablet into crash-dump mode. subsys3 is the
+    # modem: probe order venus, adsp, wcnss, modem.
+    write /sys/bus/msm_subsys/devices/subsys3/restart_level RELATED
+
+# The modem's file system lives on modemst1/modemst2/fsg/fsc; it reaches them through this daemon.
+service vendor.rmt_storage /vendor/bin/rmt_storage
+    class core
+    user root
+    shutdown critical
+    ioprio rt 0
+
+service vendor.tftp_server /vendor/bin/tftp_server
+    class core
+    user root
+
+# Boot the modem once its storage daemon is up, and keep it up (stock: pm-proxy's permanent vote).
+service vendor.modem_holder /vendor/bin/ags_modem_holder
+    class core
+    user system
+    group system
+    disabled
+
+on property:init.svc.vendor.rmt_storage=running
+    start vendor.modem_holder
diff --git a/sepolicy/file_contexts b/sepolicy/file_contexts
index 72d4c24..5d466e4 100644
--- a/sepolicy/file_contexts
+++ b/sepolicy/file_contexts
@@ -46,3 +46,6 @@
 # LiveDisplay (livedisplay/): LineageOS's sysfs LiveDisplay domain, on the panel's CABC node
 /(vendor|system/vendor)/bin/hw/vendor\.lineage\.livedisplay@2\.0-service\.ags_w09   u:object_r:hal_lineage_livedisplay_sysfs_exec:s0
 /(vendor|system/vendor)/bin/hci_qcomm_init	u:object_r:bluetooth_loader_exec:s0
+
+# Modem holder (modem/): runs in the peripheral manager domain, which may open /dev/subsys_modem
+/(vendor|system/vendor)/bin/ags_modem_holder	u:object_r:vendor_per_mgr_exec:s0
diff --git a/sepolicy/modem.te b/sepolicy/modem.te
new file mode 100644
index 0000000..fde6d27
--- /dev/null
+++ b/sepolicy/modem.te
@@ -0,0 +1,13 @@
+# Modem helpers (rootdir/init.ags_w09.modem.rc). Qualcomm grants sys_admin and the debugfs
+# statistics in sepolicy-legacy/legacy-common, which this build does not include.
+allow rmt_storage self:capability sys_admin;
+dontaudit rmt_storage debugfs:file write;
+
+# tftp_server serves the modem's files from /persist/rfs, as on stock. The Android 8 binary runs as
+# root over that tree (owned by oem_2951, mode 0700); the older Qualcomm policy
+# (sepolicy-legacy/common/rfs_access.te) grants it the same DAC capabilities.
+allow rfs_access persist_file:dir search;
+allow rfs_access self:capability { dac_override dac_read_search };
+
+# Each of them reads the /vendor directory at start-up.
+allow { rmt_storage rfs_access vendor_per_mgr } vendor_file:dir { open read };
-- 
