From b4f3bb62a20d8e756cae6bee1d8c268339e2db65 Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Sat, 7 Nov 2026 11:12:21 +0200
Subject: [PATCH] fstab: declare misc for the bootloader control block

Recovery reads its commands from misc (and clears them), and Android
writes them there for a factory reset or an update install; with no
misc entry, LineageOS Recovery logged "Failed to clear BCB message:
failed to find /misc partition". boot and recovery stay undeclared on
purpose: this bootloader rejects any image booted from those
partitions, so nothing may write them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 rootdir/fstab.qcom | 1 +
 1 file changed, 1 insertion(+)

diff --git a/rootdir/fstab.qcom b/rootdir/fstab.qcom
index fad94f5..6c92f60 100644
--- a/rootdir/fstab.qcom
+++ b/rootdir/fstab.qcom
@@ -9,3 +9,4 @@
 /dev/block/platform/soc/7824900.sdhci/by-name/userdata   /data       f2fs   rw,nosuid,nodev,noatime                wait,formattable,encryptable=footer
 /dev/block/platform/soc/7824900.sdhci/by-name/modem      /firmware   vfat   ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0  wait
 /dev/block/platform/soc/7824900.sdhci/by-name/persist    /persist    ext4   nosuid,nodev,noatime                   wait
+/dev/block/platform/soc/7824900.sdhci/by-name/misc       /misc       emmc   defaults                               defaults
-- 
2.53.0

