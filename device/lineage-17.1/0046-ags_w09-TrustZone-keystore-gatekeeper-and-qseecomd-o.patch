From 2ea1faf1d6a800d58078a9884c530efd2a67670c Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Sat, 7 Nov 2026 20:44:32 +0200
Subject: [PATCH] ags_w09: TrustZone keystore, gatekeeper and qseecomd off

This unit runs the engineering TrustZone. With qseecomd running, its
keymaster wrote records into the RPMB area the stock keymaster uses
(measured with a read-only RPMB probe: 0 writes across an engineering
bootloader boot and a full boot, 4 writes for one keystore key
generate/encrypt/delete, all in the keymaster record). Afterwards stock
EMUI, fully restored from the original backup, failed to get its
file-encryption key at every boot (vold: failed to get the key ->
system_server crash -> eRecovery), so the way back to stock was lost.

Without qseecomd no TrustZone app can reach RPMB. The keystore falls
back to AOSP's software keymaster and the lock screen to AOSP's software
gatekeeper, as in the 15.1 port. Verified: keystore operations and PIN
set/verify/clear work with 0 RPMB writes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016iwHzV2tPonTxdceSkWZtS
---
 product/gatekeeper.mk | 6 ------
 product/init.mk       | 6 +++---
 2 files changed, 3 insertions(+), 9 deletions(-)
 delete mode 100644 product/gatekeeper.mk

diff --git a/product/gatekeeper.mk b/product/gatekeeper.mk
deleted file mode 100644
index 892fb25..0000000
--- a/product/gatekeeper.mk
+++ /dev/null
@@ -1,6 +0,0 @@
-# Gatekeeper (lock screen credential checks) in TrustZone: Huawei's gatekeeper.msm8937.so talks to
-# the keymaster TrustZone app, which serves both. The 15.1 port had set the TrustZone modules aside
-# and used AOSP's software gatekeeper; with qseecomd running (init.ags_w09.tee.rc) they work.
-PRODUCT_PACKAGES += \
-    android.hardware.gatekeeper@1.0-impl \
-    android.hardware.gatekeeper@1.0-service
diff --git a/product/init.mk b/product/init.mk
index 82090aa..fcc0a1a 100644
--- a/product/init.mk
+++ b/product/init.mk
@@ -7,9 +7,9 @@ PRODUCT_PACKAGES += \
     init.wifi.sh \
     init.wifi_mac.sh
 
-# QSEECom listener daemon for TrustZone apps (stock started it from init.target.rc)
-PRODUCT_PACKAGES += \
-    init.ags_w09.tee.rc
+# No QSEECom listener daemon (qseecomd, rootdir/init.ags_w09.tee.rc): without it no TrustZone app
+# can reach RPMB. The engineering TrustZone's keymaster wrote its records into the RPMB area the
+# stock keymaster uses, and stock EMUI then failed to get its file-encryption key at every boot.
 
 # Vendor helper scripts
 PRODUCT_PACKAGES += \
-- 
2.53.0

