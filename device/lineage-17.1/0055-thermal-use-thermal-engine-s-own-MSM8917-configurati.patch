-sampling 50
-sensor VIRTUAL-CPUS
-device cpu_voltage
-set_point 85000
-set_point_clr 55000
-time_constant 0
-
-[SPEAKER-CAL]
-sampling 30000 30000 10 1800000
-sensor pm8937_tz
-sensors tsens_tz_sensor1 tsens_tz_sensor2 tsens_tz_sensor3 tsens_tz_sensor10
-temp_range 6000 10000 2000
-max_temp 45000
-offset -4000
