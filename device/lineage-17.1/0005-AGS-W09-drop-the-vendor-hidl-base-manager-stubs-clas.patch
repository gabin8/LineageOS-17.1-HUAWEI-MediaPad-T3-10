-# distributed under the License is distributed on an "AS IS" BASIS,
-# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
-# See the License for the specific language governing permissions and
-# limitations under the License.
-
-include $(CLEAR_VARS)
-LOCAL_SHARED_LIBRARIES := libhidltransport
-LOCAL_MODULE := android.hidl.base@1.0
-LOCAL_MODULE_TAGS := optional
-LOCAL_MODULE_CLASS := SHARED_LIBRARIES
-LOCAL_VENDOR_MODULE := true
-include $(BUILD_SHARED_LIBRARY)
-
-include $(CLEAR_VARS)
-LOCAL_SHARED_LIBRARIES := libhidltransport
-LOCAL_MODULE := android.hidl.manager@1.0
-LOCAL_MODULE_TAGS := optional
-LOCAL_MODULE_CLASS := SHARED_LIBRARIES
-LOCAL_VENDOR_MODULE := true
-include $(BUILD_SHARED_LIBRARY)
diff --git a/product/hidl.mk b/product/hidl.mk
index f6bc70e..e181992 100644
--- a/product/hidl.mk
+++ b/product/hidl.mk
@@ -1,5 +1,6 @@
 # HIDL
+# The 15.1 tree built empty android.hidl.base@1.0 / android.hidl.manager@1.0 stubs into /vendor
+# (libhidl/). On Q android.hidl.base@1.0 is a real (VNDK) library and the stub clashes; the
+# prebuilt v2 vendor already carries the stubs. Revisit for the stage B vendor.
 PRODUCT_PACKAGES += \
-    android.hidl.base@1.0 \
-    android.hidl.manager@1.0 \
     android.hidl.manager@1.0-java
