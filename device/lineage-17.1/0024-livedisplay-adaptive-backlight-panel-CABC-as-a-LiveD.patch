diff --git a/sepolicy/file_contexts b/sepolicy/file_contexts
index 36e6912..abb28ad 100644
--- a/sepolicy/file_contexts
+++ b/sepolicy/file_contexts
@@ -42,3 +42,6 @@
 # Android 10's cgroups.json creates /dev/stune, but this 3.18 kernel has no schedtune, so the
 # directories stay plain tmpfs. Label them as the cgroup they stand in for (writes are no-ops).
 /dev/stune(/.*)?                            u:object_r:cgroup:s0
+
+# LiveDisplay (livedisplay/): LineageOS's sysfs LiveDisplay domain, on the panel's CABC node
+/(vendor|system/vendor)/bin/hw/vendor\.lineage\.livedisplay@2\.0-service\.ags_w09   u:object_r:hal_lineage_livedisplay_sysfs_exec:s0
diff --git a/sepolicy/hal_lineage_livedisplay_sysfs.te b/sepolicy/hal_lineage_livedisplay_sysfs.te
new file mode 100644
index 0000000..7b64274
--- /dev/null
+++ b/sepolicy/hal_lineage_livedisplay_sysfs.te
@@ -0,0 +1,2 @@
+allow hal_lineage_livedisplay_sysfs sysfs_graphics:dir search;
+allow hal_lineage_livedisplay_sysfs sysfs_lcd_cabc:file rw_file_perms;
